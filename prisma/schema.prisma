// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model TestConnection {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  message   String
}

/// ===========================================================================
/// Better Auth — modèles `user`, `session`, `account`, `verification`.
///
/// ⚠️ Ces quatre modèles appartiennent à Better Auth : leurs champs reproduisent
/// exactement le schéma attendu par son adaptateur Prisma (cf.
/// src/lib/auth/server.ts). Renommer ou retirer un champ casse l'authentification.
/// Ce qui nous appartient en propre est signalé au cas par cas ci-dessous.
///
/// L'authentification (identité, mot de passe, session) est intégralement gérée
/// par Better Auth. L'autorisation (qui a le droit de faire quoi) reste au
/// projet : `role` et `permissions`, lus par src/lib/auth/permissions.ts.
/// ===========================================================================

/// Compte de la console d'administration.
///
/// Aucune inscription publique n'existe : `emailAndPassword.disableSignUp` est
/// actif, et les comptes sont créés depuis le module « Utilisateurs » via
/// `auth.api.createUser`. Le mot de passe n'est jamais stocké ici — il vit dans
/// `Account.password`, haché par Better Auth.
model User {
  id            String   @id @default(cuid())
  /// Requis par Better Auth. À défaut de nom saisi, l'adresse en tient lieu.
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// --- Plugin `admin` de Better Auth --------------------------------------
  /// `role` est une CHAÎNE et non une enum Prisma : le plugin la traite comme
  /// telle et l'écrit lui-même (bannissement, changement de rôle). Une enum
  /// ferait échouer l'écriture sur une valeur inattendue au lieu de la refuser
  /// proprement. Les valeurs admises sont contrôlées par `isRole()`
  /// (src/lib/auth/permissions.ts), unique source de vérité des rôles.
  role       String    @default("EDITOR")
  /// Désactivation d'un compte. Better Auth révoque les sessions au bannissement
  /// et refuse la connexion tant qu'il dure : l'accès se ferme immédiatement.
  banned     Boolean   @default(false)
  banReason  String?
  banExpires DateTime?

  /// --- Autorisation propre au projet --------------------------------------
  /// Modules autorisés en plus du socle du rôle. Vide pour un ADMIN, qui a tout.
  permissions String[]  @default([])
  /// Dernière connexion, alimentée par un `databaseHook` Better Auth à la
  /// création de session (cf. src/lib/auth/server.ts).
  lastLoginAt DateTime?

  sessions Session[]
  accounts Account[]

  /// Dossiers MGP dont ce compte est responsable.
  grievances      Grievance[]      @relation("GrievanceAssignee")
  /// Actions journalisées sur les dossiers MGP.
  grievanceEvents GrievanceEvent[] @relation("GrievanceEventAuthor")

  /// Articles dont ce compte est l'AUTEUR affiché (signature publique).
  articlesSignes   Article[]    @relation("ArticleAuteur")
  /// Articles saisis par ce compte — trace interne, jamais publiée.
  articlesSaisis   Article[]    @relation("ArticleSaisiPar")
  /// Visuels téléversés dans la bibliothèque de médias.
  mediasTeleverses MediaAsset[]

  /// Événements saisis par ce compte — trace interne, jamais publiée.
  evenementsSaisis Evenement[] @relation("EvenementSaisiPar")

  /// Rapports et documents déposés par ce compte — trace interne.
  documentsDeposes Document[]      @relation("DocumentDeposePar")
  /// Rapports dont ce compte est l'AUTEUR affiché (signature publique).
  documentsSignes  Document[]      @relation("DocumentAuteur")
  /// Sections « Histoires & impact » saisies par ce compte — trace interne.
  impactSaisi      ImpactSection[] @relation("ImpactSaisiPar")
  /// Fiches de l'équipe saisies par ce compte — trace interne.
  equipeSaisie     TeamMember[]    @relation("TeamMemberSaisiPar")
  /// Photos et vidéos publiées dans la galerie par ce compte — trace interne.
  galerieSaisie    GalerieItem[]   @relation("GalerieSaisiPar")
  /// Albums de la galerie créés par ce compte — trace interne.
  albumsSaisis     GalerieAlbum[]  @relation("AlbumSaisiPar")
  /// Composantes du Projet saisies par ce compte — trace interne.
  composantesSaisies Composante[]  @relation("ComposanteSaisiePar")

  /// Traductions assistées relues par ce compte — trace interne.
  traductionsRelues TraductionAssistee[] @relation("TraductionReluePar")

  @@index([role])
}

/// Session Better Auth. `token` est la valeur portée par le cookie.
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Plugin `admin` : trace d'une session ouverte par usurpation d'identité.
  impersonatedBy String?

  @@index([userId])
}

/// Moyen d'authentification rattaché à un compte. Pour ce projet, un seul type :
/// `providerId = "credential"`, dont `password` porte l'empreinte calculée par
/// Better Auth (scrypt). Aucun mot de passe en clair n'existe nulle part.
model Account {
  id         String @id @default(cuid())
  accountId  String
  providerId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Jetons à durée de vie courte de Better Auth. Inutilisé en pratique ici (ni
/// vérification d'adresse, ni réinitialisation en libre-service), mais la table
/// fait partie du schéma attendu par l'adaptateur.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// Étape du dossier dans la pipeline de traitement, celle-là même qui est
/// publiée sur le site (cf. `mgpPipeline` dans src/content/mgp.ts).
/// L'étape dit OÙ en est l'instruction ; le statut dit DANS QUEL ÉTAT elle est.
enum GrievanceStage {
  RECEPTION
  CLASSIFICATION
  INSTRUCTION
  DECISION
  CLOTURE
}

/// Statut de gestion du dossier. Séparé de l'étape parce que les deux
/// répondent à des questions différentes : une plainte peut être « en attente »
/// (du plaignant) alors qu'elle est à l'étape « Instruction ».
enum GrievanceStatus {
  NOUVELLE
  RECEVABLE
  IRRECEVABLE
  EN_TRAITEMENT
  EN_ATTENTE
  RESOLUE
  CLOTUREE
}

enum GrievancePriority {
  BASSE
  NORMALE
  HAUTE
  CRITIQUE
}

/// Nature d'une entrée de l'historique. `MESSAGE` est le seul type destiné à
/// être lu par le plaignant ; tous les autres restent internes.
enum GrievanceEventType {
  DEPOT
  STATUT
  ETAPE
  PRIORITE
  AFFECTATION
  NOTE
  MESSAGE
  CONTACT
}

/// Une plainte déposée par le formulaire public du MGP.
///
/// ⚠️ Le seul identifiant communiqué au plaignant est `reference` : il sert de
/// justificatif au suivi public, donc il est TIRÉ AU SORT (cf.
/// src/lib/mgp/reference.ts) et ne dérive d'aucune donnée personnelle. `id`
/// (cuid, séquentiel dans le temps) ne sort jamais de la console.
///
/// L'anonymat se lit sur `isAnonymous`, dérivé du seul champ « Nom complet » :
/// une personne peut laisser un moyen de contact sans se nommer.
model Grievance {
  id          String @id @default(cuid())
  reference   String @unique
  /// Code de la catégorie choisie à l'étape 1 (cf. src/content/mgp.ts). Un code
  /// et non un libellé : le formulaire est bilingue, le dossier ne l'est pas.
  category    String
  description String

  /// Identité et coordonnées : toutes facultatives, jamais exposées au public.
  fullName    String?
  email       String?
  phone       String?
  province    String?
  /// Langue de dépôt — détermine celle dans laquelle recontacter la personne.
  lang        String  @default("fr")
  isAnonymous Boolean @default(true)

  status   GrievanceStatus   @default(NOUVELLE)
  stage    GrievanceStage    @default(RECEPTION)
  priority GrievancePriority @default(NORMALE)

  assigneeId String?
  /// `SetNull` : supprimer un compte ne doit jamais emporter un dossier.
  assignee   User?   @relation("GrievanceAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  submittedAt DateTime  @default(now())
  /// Échéance de l'engagement public de 30 jours, figée au dépôt.
  dueAt       DateTime
  closedAt    DateTime?
  updatedAt   DateTime  @updatedAt

  attachments GrievanceAttachment[]
  events      GrievanceEvent[]

  @@index([status, submittedAt])
  @@index([stage])
  @@index([assigneeId])
}

/// Pièce annoncée par le plaignant à l'étape 3.
///
/// ⚠️ Seules les MÉTADONNÉES sont conservées : aucun service de stockage de
/// fichiers n'est raccordé au projet à ce stade. L'agent voit ce que la personne
/// a voulu joindre et le lui redemande par le canal de contact.
model GrievanceAttachment {
  id          String    @id @default(cuid())
  grievanceId String
  grievance   Grievance @relation(fields: [grievanceId], references: [id], onDelete: Cascade)
  name        String
  sizeKb      Int
  createdAt   DateTime  @default(now())

  @@index([grievanceId])
}

/// Journal d'un dossier : dépôt, changements d'état, affectations, notes
/// internes et messages adressés au plaignant. Rien n'est modifiable ni
/// supprimable — l'historique est la mémoire du traitement.
model GrievanceEvent {
  id          String             @id @default(cuid())
  grievanceId String
  grievance   Grievance          @relation(fields: [grievanceId], references: [id], onDelete: Cascade)
  type        GrievanceEventType
  /// `true` uniquement pour les messages publiés dans le suivi public.
  isPublic    Boolean            @default(false)
  message     String?
  /// Valeurs d'avant et d'après, pour les changements d'état.
  fromValue   String?
  toValue     String?

  authorId    String?
  author      User?   @relation("GrievanceEventAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  /// Nom de l'auteur figé à l'écriture : l'historique doit rester lisible même
  /// après la suppression du compte qui a agi.
  authorLabel String?

  createdAt DateTime @default(now())

  @@index([grievanceId, createdAt])
}

/// ---------------------------------------------------------------------------
/// CMS d'actualités
///
/// Un article = une fiche commune (statut, date, catégorie, visuel, auteur) et
/// UNE LIGNE DE TRADUCTION PAR LANGUE. Le titre, le slug, le résumé, le corps
/// et les métadonnées SEO vivent dans la traduction, jamais dans la fiche : une
/// langue non traduite se reconnaît alors à l'absence de sa ligne, ce qui permet
/// à la console de la signaler et au site public de ne pas servir un contenu
/// dans la mauvaise langue.
///
/// Les catégories et les étiquettes, elles, portent leurs deux libellés en
/// colonnes (`nomFr` / `nomEn`) : ce sont des mots isolés, alignés sur le type
/// `Bilingual` du reste du contenu (cf. src/lib/pick.ts).
/// ---------------------------------------------------------------------------

/// Cycle de vie d'un article. `SCHEDULED` n'exige aucune tâche planifiée : la
/// bascule se fait à la lecture, en comparant `publishedAt` à l'instant courant
/// (cf. src/lib/actus/statut.ts).
enum ArticleStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

/// Bibliothèque de médias et de documents.
///
/// Une seule table, trois provenances distinguées par les colonnes renseignées :
///   - fichier TÉLÉVERSÉ chez Cloudinary : `url` + `publicId` (cas normal) ;
///   - média EXTERNE saisi à la main : `url` seule, hébergé ailleurs ;
///   - fichier HISTORIQUE : `data` renseigné, servi par /api/medias/<id>.
///
/// Les octets ne sont plus écrits en base : un visuel de 3 Mo y coûtait une
/// ligne de 3 Mo, sauvegardée et restaurée à chaque copie de la base, et servie
/// par l'application au lieu d'un CDN. `data` ne subsiste que pour les fichiers
/// déposés avant la bascule (cf. scripts/migrate-medias-cloudinary.mjs, qui les
/// reprend puis vide la colonne). Corollaire inchangé tant qu'elle existe :
/// `data` n'est JAMAIS sélectionné hors de la route qui sert le fichier.
model MediaAsset {
  id        String   @id @default(cuid())
  /// Nom d'origine, conservé pour la recherche dans la bibliothèque.
  filename  String
  mimeType  String
  /// Poids du fichier. Évite de charger le binaire pour afficher une liste, et
  /// reste la seule source du poids pour un fichier hébergé chez Cloudinary.
  size      Int      @default(0)
  width     Int?
  height    Int?
  /// HISTORIQUE : octets des fichiers antérieurs à la bascule vers Cloudinary.
  /// Aucune écriture nouvelle. À supprimer quand la reprise sera terminée.
  data      Bytes?
  url       String?
  /// Identifiant Cloudinary — la seule prise pour retirer le fichier du compte
  /// à la suppression du média. Nul pour un média externe, dont le fichier ne
  /// nous appartient pas.
  publicId  String?
  altFr     String?
  altEn     String?
  legende   String?
  createdAt DateTime @default(now())

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  couvertures Article[]
  /// Événements dont ce média est l'image de couverture.
  affiches    Evenement[]
  /// Entrées « Histoires & impact » illustrées par ce média.
  impacts     ImpactItem[]
  /// Portraits des membres de l'équipe.
  portraits   TeamMember[]
  /// Rapports rédigés en ligne dont ce média est l'image de couverture.
  couverturesDoc Document[]
  /// Visuels de héros des pages de composante.
  herosComposante Composante[]     @relation("ComposanteCouverture")
  /// Visuels des projets phares d'une composante.
  visuelsProjet   ComposanteBloc[] @relation("ComposanteBlocVisuel")

  @@index([createdAt])
}

/// Catégorie d'article — sert aussi de filtre sur la page publique.
model ArticleCategory {
  id        String   @id @default(cuid())
  /// Identifiant d'URL, stable : il apparaît dans ?categorie=… .
  slug      String   @unique
  nomFr     String
  nomEn     String
  /// Couleur d'accent de la pastille. Vide = accent du site (var(--ac)).
  color     String?
  /// Ordre d'affichage des filtres.
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles Article[]

  @@index([position])
}

/// Étiquette transverse. Plus fine qu'une catégorie : un article n'a qu'une
/// catégorie, mais autant d'étiquettes que nécessaire.
model Tag {
  id        String   @id @default(cuid())
  slug      String   @unique
  nomFr     String
  nomEn     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles ArticleTag[]
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

/// Fiche commune d'un article, indépendante de la langue.
model Article {
  id          String        @id @default(cuid())
  status      ArticleStatus @default(DRAFT)
  /// Date de publication — passée pour un article en ligne, future pour un
  /// article programmé. `null` tant que rien n'a été programmé ni publié.
  publishedAt DateTime?
  /// Mise en avant : remonte l'article en tête de la page « Actualités ».
  featured    Boolean       @default(false)
  /// Lieu de l'événement rapporté (« Kinshasa », « Paris / Kinshasa »).
  lieu        String?
  /// Identifiant YouTube de la vidéo associée, le cas échéant.
  videoYt     String?
  /// Composantes rattachées (C1…C5) — alimente le bloc « Actualités » des
  /// pages composante (cf. src/components/composantes/CompLies.tsx).
  comps       String[]      @default([])

  categoryId String?
  category   ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// Image de couverture issue de la bibliothèque.
  coverMediaId String?
  coverMedia   MediaAsset? @relation(fields: [coverMediaId], references: [id], onDelete: SetNull)
  /// Repli : clé du registre d'images intégré (cf. src/content/media.ts), pour
  /// les articles repris de la version statique du site.
  coverKey     String?

  /// Auteur affiché, quand c'est un compte de la console.
  authorId   String?
  author     User?   @relation("ArticleAuteur", fields: [authorId], references: [id], onDelete: SetNull)
  /// Signature libre, quand l'auteur n'a pas de compte (« UGPTN »).
  ///
  /// Le NOM seulement : c'est un nom propre, il ne se traduit pas. La FONCTION
  /// qui l'accompagne a rejoint `ArticleTranslation.authorRole`, où elle peut
  /// différer d'une langue à l'autre.
  authorName String?

  /// Trace de saisie, interne à la console.
  createdById String?
  createdBy   User?   @relation("ArticleSaisiPar", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations ArticleTranslation[]
  tags         ArticleTag[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([featured])
}

/// Version d'un article dans une langue. Tout ce qui se lit est ici.
model ArticleTranslation {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  /// Code de langue du site (« fr », « en » — cf. src/lib/params.ts).
  locale    String

  title String
  /// Segment d'URL, unique DANS SA LANGUE : /fr/actualites/<slug>.
  slug  String

  excerpt     String?
  /// Corps de l'article, HTML déjà assaini à l'écriture
  /// (cf. src/lib/html/sanitize.ts). Jamais de HTML brut de l'éditeur en base.
  contentHtml String  @default("")

  seoTitle       String?
  seoDescription String?
  /// Texte alternatif de l'image de couverture, propre à la langue.
  coverAlt       String?

  /// Fonction affichée sous la signature (« Cellule communication »).
  ///
  /// Elle a d'abord vécu sur la fiche, en un seul exemplaire : « Cellule
  /// communication » paraissait donc tel quel sous un article anglais. C'est un
  /// LIBELLÉ, pas un nom propre — sa place est ici, avec le reste de ce qui se
  /// lit. Le nom, lui, reste sur la fiche : « UGPTN » ne se traduit pas.
  authorRole     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([articleId, locale])
  @@unique([locale, slug])
  @@index([locale])
}

/// ---------------------------------------------------------------------------
/// Newsletter
///
/// Périmètre volontairement réduit à la COLLECTE et à l'EXPORT : le site
/// recueille des adresses, la console les gère et les sort en fichier. Aucun
/// envoi n'est effectué depuis l'application, et aucune table de campagne
/// n'existe.
///
/// Ce qui rend l'envoi possible plus tard sans reprendre la liste : chaque
/// abonné porte sa langue, son statut de consentement et son jeton de
/// désabonnement. Un module d'envoi se brancherait dessus en ajoutant ses
/// propres tables, sans toucher à celle-ci ni aux consentements qu'elle
/// enregistre.
/// ---------------------------------------------------------------------------

/// État d'un abonnement. Une seule ligne par adresse, quel que soit le nombre
/// d'allers-retours : un désabonnement n'efface rien, il bascule ce statut.
/// C'est ce qui permet de refuser une réinscription silencieuse (cf.
/// src/actions/newsletter.ts).
enum NewsletterStatus {
  ACTIVE
  UNSUBSCRIBED
}

/// Une adresse collectée.
///
/// ⚠️ Donnée personnelle : cette table ne sort de la console que par l'export du
/// module « Newsletter », réservé aux comptes disposant de la permission
/// homonyme. Aucune route publique ne lit une adresse — les pages de gestion
/// d'abonnement travaillent sur le seul `token`.
model NewsletterSubscriber {
  id    String @id @default(cuid())
  /// Normalisée (minuscules, sans espaces) avant écriture : la contrainte
  /// d'unicité porte sur cette forme, c'est elle qui empêche les doublons.
  email String @unique

  /// Langue du formulaire au moment de l'inscription. Détermine la langue des
  /// messages qui lui seront adressés.
  lang   String           @default("fr")
  status NewsletterStatus @default(ACTIVE)

  /// Provenance de l'adresse : « site » pour le formulaire public, « console »
  /// pour une saisie interne, « import » pour une reprise de liste existante.
  /// Chaîne et non enum : un import futur nommera sa propre origine sans
  /// migration.
  source String @default("site")

  /// Jeton porté par les liens de gestion d'abonnement (désabonnement,
  /// confirmation de réinscription). TIRÉ AU SORT et non dérivé de l'adresse :
  /// il circule dans des e-mails et ne doit rien apprendre de son porteur.
  token String @unique

  /// Date de la dernière inscription effective — remise à jour lors d'une
  /// réinscription, pour que la liste dise depuis quand l'adresse est active.
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?

  /// Adresse d'origine de la soumission, conservée pour instruire un abus.
  ip String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, subscribedAt])
}

/// ===========================================================================
/// Événements
///
/// Deux axes INDÉPENDANTS gouvernent un événement, et les confondre est la
/// première erreur à éviter :
///
///   · le STATUT DE PUBLICATION — brouillon, publié, archivé — décidé par la
///     rédaction, stocké dans `status` ;
///   · la PHASE dans le temps — à venir, en cours, terminé — qui n'est PAS
///     stockée : elle se déduit de `startAt` / `endAt` à la lecture
///     (cf. src/lib/events/statut.ts). Aucune tâche planifiée n'entre en jeu,
///     et un événement ne peut donc jamais rester « à venir » la veille de sa
///     tenue parce qu'un planificateur est tombé.
///
/// Le découpage fiche / traduction reproduit celui des actualités : ce qui ne
/// dépend d'aucune langue vit sur `Evenement`, tout ce qui se lit vit sur
/// `EvenementTranslation`. Les deux s'enregistrent par des formulaires séparés
/// (cf. src/actions/admin-evenements.ts).
/// ===========================================================================

/// Cycle de vie éditorial d'un événement.
///
/// Pas de `SCHEDULED` ici, contrairement aux articles : la date qui compte pour
/// un événement est celle de sa TENUE, pas celle de sa mise en ligne. Programmer
/// la parution d'une annonce d'événement reviendrait à porter deux calendriers
/// concurrents sur la même fiche.
enum EvenementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Modalité de participation. Elle décide de ce que la fiche demande — une
/// adresse n'a de sens qu'en présentiel — et de ce que la page publique affiche.
enum EvenementMode {
  PRESENTIEL
  EN_LIGNE
  HYBRIDE
}

/// Catégorie d'événement (Forum, Atelier, Webinaire, Consultation publique…).
///
/// Jumelle d'`ArticleCategory` sans être la même table : les deux nomenclatures
/// n'ont pas le même contenu ni la même durée de vie, et les fusionner
/// obligerait chaque filtre à savoir de quel module vient chaque entrée.
model EvenementCategory {
  id        String   @id @default(cuid())
  /// Identifiant d'URL, stable : il apparaît dans ?categorie=… .
  slug      String   @unique
  nomFr     String
  nomEn     String
  /// Couleur d'accent de la pastille. Vide = accent du site (var(--ac)).
  color     String?
  /// Ordre d'affichage des filtres.
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evenements Evenement[]

  @@index([position])
}

/// Fiche commune d'un événement, indépendante de la langue.
model Evenement {
  id     String          @id @default(cuid())
  status EvenementStatus @default(DRAFT)

  /// Début de l'événement. Obligatoire : c'est la donnée qui ordonne toutes les
  /// listes et qui décide de la phase (à venir / en cours / terminé).
  startAt DateTime
  /// Fin, quand elle est connue. `null` vaut « même journée » : la phase se
  /// calcule alors sur la fin du jour de `startAt` (heure de Kinshasa), sans
  /// quoi une rencontre du matin serait annoncée « terminée » à 9 h 01.
  endAt   DateTime?
  /// Journée entière : l'heure n'est plus affichée, seule la date l'est.
  allDay  Boolean   @default(false)

  mode     EvenementMode @default(PRESENTIEL)
  /// Mise en avant : remonte l'événement en tête des listes.
  featured Boolean       @default(false)

  /// Couleur d'accent propre à l'événement (pastille, bandeau, liseré de
  /// carte). Vide : celle de la catégorie, puis l'accent du site.
  color String?

  categoryId String?
  category   EvenementCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// Image de couverture issue de la bibliothèque.
  coverMediaId String?
  coverMedia   MediaAsset? @relation(fields: [coverMediaId], references: [id], onDelete: SetNull)
  /// Repli : clé du registre d'images intégré (cf. src/content/media.ts), pour
  /// les événements repris de la version statique du site.
  coverKey     String?

  /// Lien d'inscription (billetterie, formulaire). Renseigné, il remplace la
  /// demande de participation intégrée par un renvoi vers ce service.
  registrationUrl String?
  /// Lien externe de référence : page officielle, dossier, ordre du jour.
  externalUrl     String?
  /// Lien de connexion pour un événement en ligne. Séparé d'`externalUrl` :
  /// l'un se publie, l'autre ne vaut que le jour même.
  onlineUrl       String?

  /// Organisateur affiché. Un événement est organisé par une institution ou un
  /// service, pas par un compte de la console : la signature est donc libre,
  /// sans relation vers `User`.
  organiserName  String?
  organiserEmail String?
  organiserPhone String?
  organiserUrl   String?

  /// Composantes rattachées (C1…C5), même usage que sur un article.
  comps String[] @default([])

  /// Trace de saisie, interne à la console.
  createdById String?
  createdBy   User?   @relation("EvenementSaisiPar", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations EvenementTranslation[]
  inscriptions EvenementInscription[]

  @@index([status, startAt])
  @@index([categoryId])
  @@index([featured])
}

/// Version d'un événement dans une langue. Tout ce qui se lit est ici.
///
/// Le LIEU en fait partie, contrairement à l'article où il n'est qu'une mention
/// brute : « Goma — provinces de l'Est » et « Goma — Eastern provinces » sont
/// deux libellés, pas une donnée géographique. L'adresse postale, elle, reste
/// traduisible aussi (le nom d'un bâtiment se traduit), mais n'est jamais
/// obligatoire.
model EvenementTranslation {
  id          String    @id @default(cuid())
  evenementId String
  evenement   Evenement @relation(fields: [evenementId], references: [id], onDelete: Cascade)
  /// Code de langue du site (« fr », « en » — cf. src/lib/params.ts).
  locale      String

  title String
  /// Segment d'URL, unique DANS SA LANGUE : /fr/evenements/<slug>.
  slug  String

  /// Description courte affichée sur les cartes et dans les partages.
  excerpt     String?
  /// Description complète, HTML déjà assaini à l'écriture
  /// (cf. src/lib/html/sanitize.ts). Jamais de HTML brut de l'éditeur en base.
  contentHtml String  @default("")

  /// Libellé du lieu tel qu'il s'affiche (« Kinshasa », « En ligne »).
  lieu    String?
  /// Adresse ou repère de localisation, quand la salle doit être trouvée.
  adresse String?
  /// Jauge affichée (« 320 places », « Ouvert à tous »). Un libellé et non un
  /// nombre : le site annonce aussi bien une capacité qu'une règle d'accès.
  places  String?
  /// Informations complémentaires : accès, interprétation, pièces à apporter.
  infos   String?

  seoTitle       String?
  seoDescription String?
  /// Texte alternatif de l'image de couverture, propre à la langue.
  coverAlt       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([evenementId, locale])
  @@unique([locale, slug])
  @@index([locale])
}

/// État d'une demande de participation.
///
/// `RECUE` est le seul état qu'une personne peut provoquer elle-même : tous les
/// autres sont posés par l'Unité depuis la console. La distinction compte pour
/// le décompte des places — une demande reçue n'occupe pas encore de siège.
enum InscriptionStatus {
  RECUE
  CONFIRMEE
  LISTE_ATTENTE
  ANNULEE
}

/// Demande de participation déposée par le formulaire public d'un événement.
///
/// ⚠️ Ces lignes portent des DONNÉES PERSONNELLES (identité, adresse, éventuelle
/// organisation) collectées sans compte. Trois conséquences tenues partout :
///   1. elles ne sortent JAMAIS vers le site public — aucune fonction de
///      `lib/events/query.ts` ne les lit, seule la console y accède ;
///   2. elles tombent avec l'événement (`onDelete: Cascade`) : supprimer une
///      rencontre ne doit pas laisser derrière elle une liste de participants ;
///   3. l'adresse fait l'unicité, pour qu'un double envoi mette à jour la
///      demande au lieu d'inscrire deux fois la même personne.
///
/// Le formulaire n'est proposé que si l'événement n'a PAS de lien d'inscription
/// externe : quand la billetterie est ailleurs, c'est elle qui tient la liste,
/// et en tenir une seconde ici la rendrait fausse.
model EvenementInscription {
  id          String    @id @default(cuid())
  evenementId String
  evenement   Evenement @relation(fields: [evenementId], references: [id], onDelete: Cascade)

  nom          String
  email        String
  organisation String?
  telephone    String?
  /// Question ou besoin d'accessibilité signalé au dépôt.
  message      String?

  /// Langue du formulaire au moment du dépôt — sert à répondre dans la langue
  /// où la personne s'est adressée à l'Unité.
  locale String @default("fr")

  statut InscriptionStatus @default(RECUE)
  /// Note interne de la console, jamais communiquée au demandeur.
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([evenementId, email])
  @@index([evenementId, statut])
  @@index([createdAt])
}

/// ===========================================================================
/// Rapports & analyses
///
/// Rapports, études, analyses et pièces de référence publiés dans la section
/// « Rapports & analyses » du site, et administrés par le module homonyme de la
/// console. Les identifiants techniques, eux, restent bâtis sur « document » —
/// modèles, permission et route : ce sont des clés stables, pas des libellés.
///
/// ─── Le fichier n'est PAS ici ────────────────────────────────────────────────
///
/// Seules les MÉTADONNÉES et les RÉFÉRENCES Cloudinary sont enregistrées :
/// `fileUrl` (adresse de diffusion) et `filePublicId` (prise pour retirer le
/// fichier du compte). Aucune colonne binaire, contrairement à ce que
/// `MediaAsset.data` a porté avant la bascule : une base sauvegardée, répliquée
/// et facturée à l'octet n'a pas à jouer le rôle de serveur de fichiers, et
/// l'application n'a pas à jouer celui de CDN.
///
/// ─── Pourquoi pas de table de traduction ─────────────────────────────────────
///
/// Contrairement à `Article` et `Evenement`, les deux langues vivent en
/// COLONNES (`titreFr` / `titreEn`), comme sur `ArticleCategory`. Un document
/// porte un titre et une description courte — pas un corps rédactionnel avec son
/// slug, son SEO et son cycle de relecture propre. Une table de traduction
/// imposerait un formulaire par langue et un enregistrement séparé pour deux
/// champs, alors que le FICHIER, lui, reste le même dans les deux versions du
/// site. L'anglais vide retombe sur le français : mieux vaut servir un titre
/// français à un lecteur anglophone que masquer le document.
///
/// La langue du FICHIER, elle, est une information distincte et affichée
/// (`langue`) : le document peut n'exister qu'en français.
/// ===========================================================================

/// Cycle de vie d'un document.
///
/// Les trois états correspondent aux trois gestes demandés au CMS — publier,
/// dépublier, archiver. Pas de `SCHEDULED` : `publishedAt` est la date que
/// PORTE le document, pas un déclencheur de parution. Programmer la mise en
/// ligne d'un rapport n'a pas d'usage établi, et le faire croire coûterait une
/// tâche planifiée.
enum DocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Nature du document. Enum et non chaîne libre : c'est un axe de FILTRE sur le
/// site public, et une saisie libre y produirait autant de valeurs que de
/// saisies. La catégorie, elle, reste une table — les thématiques du projet
/// évoluent, la nature d'un écrit non.
enum DocumentType {
  RAPPORT
  ETUDE
  ANALYSE
  NOTE
  MANUEL
  PLAN
  CADRE
  PRESENTATION
  DONNEES
  AUTRE
}

/// Sur quoi repose la publication : un fichier déposé, ou un texte rédigé dans
/// la console.
///
/// Le champ ne dit pas ce que la pièce EST — c'est le rôle de `DocumentType` —
/// mais comment elle se lit. La distinction commande trois choses :
///   · ce que le formulaire de la console demande (un téléversement, ou
///     l'éditeur de texte et ses blocs) ;
///   · ce qu'il faut avoir pour publier (un fichier, ou un corps non vide) ;
///   · ce que le site sert — une fiche à télécharger, ou une page de lecture à
///     l'adresse `/<lang>/resources/<slug>`.
///
/// Les deux ne s'excluent pas : une publication rédigée peut porter un fichier
/// en pièce jointe (la version PDF signée d'une note, par exemple), et c'est
/// pourquoi les colonnes de fichier restent renseignables dans les deux cas.
enum DocumentSupport {
  FICHIER
  REDIGE
}

/// Catégorie ou thématique documentaire — sert aussi de filtre public.
///
/// Table distincte d'`ArticleCategory` et d'`EvenementCategory`, pour la raison
/// déjà donnée sur cette dernière : les trois nomenclatures n'ont ni le même
/// contenu ni la même durée de vie, et les fusionner obligerait chaque filtre à
/// savoir de quel module vient chaque entrée.
model DocumentCategory {
  id        String   @id @default(cuid())
  /// Identifiant d'URL, stable : il apparaît dans ?categorie=… .
  slug      String   @unique
  nomFr     String
  nomEn     String
  /// Couleur d'accent de la pastille. Vide = accent du site (var(--ac)).
  color     String?
  /// Ordre d'affichage des filtres.
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Document[]

  @@index([position])
}

/// Un rapport, une étude, une analyse ou une pièce de référence.
model Document {
  id      String          @id @default(cuid())
  status  DocumentStatus  @default(DRAFT)
  type    DocumentType    @default(RAPPORT)
  support DocumentSupport @default(FICHIER)

  /// Segment d'URL de la page de lecture — `/fr/resources/<slug>` comme
  /// `/en/resources/<slug>`.
  ///
  /// UN SEUL slug pour les deux langues, contrairement aux articles qui en
  /// portent un par traduction : une pièce documentaire est d'abord une
  /// référence citée dans les échanges du projet, et lui donner deux adresses
  /// selon la langue de lecture multiplierait les liens à corriger le jour où
  /// le titre anglais arrive. Nullable pour les lignes antérieures à la page de
  /// lecture : elles sont servies par leur identifiant tant qu'elles n'ont pas
  /// été réenregistrées (cf. lib/docs/query.ts).
  slug String? @unique

  titreFr String
  /// Vide, le titre français est servi dans les deux langues (cf. l'en-tête).
  titreEn String?

  descriptionFr String?
  descriptionEn String?

  /// Corps de la publication rédigée, HTML déjà assaini à l'écriture
  /// (cf. src/lib/html/sanitize.ts). Jamais de HTML brut de l'éditeur en base.
  /// Vide pour un document qui n'existe que par son fichier.
  contenuFr String @default("")
  /// Version anglaise du corps. Vide, la page anglaise sert le français en le
  /// signalant — même règle que les titres, et pour la même raison : une pièce
  /// d'intérêt public ne se cache pas derrière une traduction en attente.
  contenuEn String @default("")

  /// Sigle documentaire (« MEP », « PPSD », « CGES »), quand il en existe un.
  /// C'est par lui que ces pièces sont désignées dans les échanges du projet.
  reference String?
  /// Version publiée (« v1.0 », « T2 2026 », « évolutif »).
  ///
  /// CHAÎNE LIBRE et non un numéro : les pièces du projet ne se versionnent pas
  /// toutes de la même façon. Un cadre de sauvegardes porte un numéro d'édition,
  /// un plan de passation se repère à son trimestre, et le PEES est déclaré
  /// « évolutif » parce qu'il est révisé en continu. Imposer un format unique
  /// obligerait à mentir sur l'un des trois.
  ///
  /// La page publique annonce que « le versionnage est explicite : une version
  /// remplacée reste identifiable ». Cette colonne est ce qui rend cette phrase
  /// vraie — la retirer reviendrait à retirer l'engagement avec elle.
  version   String?
  /// Organisme producteur, tel qu'il doit s'afficher (direction, cabinet
  /// d'études, institution). Distinct de la SIGNATURE ci-dessous : l'un dit
  /// d'où vient la pièce, l'autre qui l'a écrite.
  auteur    String?
  /// Langue du FICHIER (« FR », « EN », « FR/EN ») — pas celle de la fiche.
  langue    String  @default("FR")

  /// Date de mise en ligne. Renseignée à la première publication si elle est
  /// restée vide : un document en ligne sans date n'est pas classable.
  publishedAt  DateTime?
  /// Date du document lui-même (production, édition, période couverte).
  /// Distincte de la précédente : un rapport de 2025 peut être publié en 2026,
  /// et c'est la date du document qui fait foi pour le lecteur.
  documentDate DateTime?

  /// Mise en avant : remonte le document en tête de la liste publique.
  featured Boolean  @default(false)
  /// Ordre d'affichage, à date égale. Plus petit = plus haut.
  position Int      @default(0)
  /// Composantes rattachées (C1…C5), même usage que sur un article.
  comps    String[] @default([])

  categoryId String?
  category   DocumentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// Image de couverture de la page de lecture, issue de la bibliothèque.
  /// Sans objet pour un document qui n'existe que par son fichier.
  coverMediaId String?
  coverMedia   MediaAsset? @relation(fields: [coverMediaId], references: [id], onDelete: SetNull)

  /// --- Signature : QUI a écrit, par opposition à qui a saisi --------------
  /// La personne qui rédige n'est pas celle qui tient la console : un chargé
  /// d'études écrit la note, un administrateur la met en ligne. Publier le nom
  /// du second attribuerait le texte à quelqu'un qui ne l'a pas écrit.
  ///
  /// Même triplet que les articles, et pour la même raison : `authorId` quand
  /// l'auteur a un compte, `authorName` quand il n'en a pas (« Cellule suivi &
  /// évaluation »), `authorRole` pour la fonction affichée sous le nom.
  authorId   String?
  author     User?   @relation("DocumentAuteur", fields: [authorId], references: [id], onDelete: SetNull)
  authorName String?
  authorRole String?

  /// --- Fichier : RÉFÉRENCES Cloudinary, jamais d'octets -------------------
  ///
  /// ⚠️ Nullables depuis l'ouverture du module à la rédaction en ligne : un
  /// rapport écrit dans la console n'a pas de fichier, et lui en inventer un
  /// (chaîne vide) obligerait chaque lecture à distinguer « vide » de
  /// « absent ». `null` dit ce qu'il en est. Une publication rédigée PEUT
  /// néanmoins porter une pièce jointe, auquel cas ces colonnes la décrivent.
  ///
  /// URL de diffusion HTTPS, telle que Cloudinary la renvoie. C'est elle que le
  /// site public sert au visiteur.
  fileUrl      String?
  /// Identifiant Cloudinary — seule prise pour retirer le fichier du compte à
  /// la suppression du document ou au remplacement du fichier.
  filePublicId String?
  /// Nom d'origine, conservé pour la recherche et pour nommer le téléchargement.
  fileName     String?
  fileMime     String?
  /// Poids rapporté par Cloudinary, seule source du « PDF · 4,2 Mo » affiché.
  fileSize     Int     @default(0)
  /// Extension normalisée (« pdf », « docx »), pour la pastille de format.
  fileFormat   String?

  /// Trace de dépôt, interne à la console.
  createdById String?
  createdBy   User?   @relation("DocumentDeposePar", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([type])
  @@index([featured])
  @@index([support])
}

/// Histoires & impact
///
/// Le module ne gère pas UNE page mais SIX emplacements répartis sur trois
/// pages publiques (accueil, résultats, projet). Ce qu'ils ont en commun n'est
/// pas leur dessin — une frise de jalons ne ressemble pas à une grille de
/// témoignages — mais leur nature : ce sont les blocs qui racontent d'où vient
/// le Projet et ce qu'il change.
///
/// ─── Deux niveaux, et un seul dessin par niveau ─────────────────────────────
///
///   · une SECTION porte l'en-tête (kicker, titre, chapô, bouton), le fond, la
///     place dans la page et le GABARIT de ses entrées ;
///   · un ITEM porte une entrée de la section : un chiffre, un témoignage, un
///     jalon, un diptyque avant/après, une carte sectorielle.
///
/// Le gabarit (`layout`) décide de ce qui se lit dans un item, et donc de ce
/// que le formulaire demande. C'est ce qui évite deux écueils symétriques : une
/// table par bloc — cinq modules à maintenir pour cinq grilles —, et un champ
/// « contenu libre » — qui rendrait chaque section responsable de son propre
/// HTML, donc de sa propre dérive graphique.
///
/// ─── Découpage fiche / traduction ───────────────────────────────────────────
/// Identique aux actualités et aux événements : ce qui ne dépend d'aucune
/// langue vit sur la fiche, tout ce qui se lit vit sur la traduction. Une
/// langue non traduite se reconnaît à l'absence de sa ligne, ce qui permet à la
/// console de la signaler et au site de ne jamais servir un texte français à un
/// lecteur anglophone.
/// ===========================================================================

/// Cycle de vie d'une section comme d'une entrée.
///
/// Pas de `SCHEDULED` ni d'`ARCHIVED` ici, contrairement aux actualités : ces
/// blocs sont des éléments de page, pas des parutions. Une section se montre ou
/// se retire, et le retrait n'a pas de mémoire à conserver.
enum ImpactStatus {
  DRAFT
  PUBLISHED
}

/// Où la section s'affiche sur le site public.
///
/// ⚠️ Valeur STRUCTURANTE : chaque emplacement correspond à un point d'insertion
/// réel dans une page (cf. src/lib/impact/query.ts et les pages publiques). En
/// ajouter un suppose d'ouvrir ce point d'insertion dans la page concernée ;
/// tout le reste — textes, entrées, ordre, fond — se pilote depuis la console
/// sans toucher au code.
enum ImpactEmplacement {
  ACCUEIL_IMPACT
  ACCUEIL_HISTOIRES
  RESULTATS_DIALOGUES
  RESULTATS_HISTOIRES
  PROJET_CHANGEMENTS
  PROJET_JALONS

  /// Page « L'UGPTN » — la citation qui suit le héros.
  UGPTN_ENGAGEMENT
  /// Page « L'UGPTN » — les fonctions de l'Unité.
  UGPTN_MANDAT
  /// Page « L'UGPTN » — les règles, puis les engagements qui en découlent.
  UGPTN_PRINCIPES
  /// Page « L'UGPTN » — repères et organigramme des pôles.
  UGPTN_ORGANISATION
  /// Page « L'UGPTN » — le cycle répété marché après marché.
  UGPTN_METHODE
  /// Page « L'UGPTN » — l'en-tête de la grille des fiches.
  UGPTN_EQUIPE
  /// Page « L'UGPTN » — questions fréquentes, puis glossaire replié.
  UGPTN_QUESTIONS

  /// Page « Le projet » — contexte, chiffres d'entrée et aplat.
  PROJET_CONTEXTE
  /// Page « Le projet » — les publics visés.
  PROJET_POUR_QUI
  /// Page « Le projet » — l'en-tête de l'aperçu des composantes.
  PROJET_COMPOSANTES
  /// Page « Le projet » — l'en-tête de l'aperçu des indicateurs.
  PROJET_RESULTATS
  /// Page « Le projet » — la foire aux questions citoyenne.
  PROJET_QUESTIONS
}

/// Dessin des entrées d'une section. Chaque gabarit reproduit à l'identique un
/// bloc qui existait déjà en dur dans les pages (cf. src/components/impact/).
enum ImpactLayout {
  /// Grille de chiffres : grande valeur, unité en accent, phrase d'explication.
  STATS
  /// Cartes de témoignage : portrait cliquable (vidéo), nom, rôle, citation.
  TEMOIGNAGES
  /// Cartes sectorielles : secteur en accent, titre, description.
  CARTES
  /// Diptyque : numéro, intitulé, situation actuelle puis situation visée.
  AVANT_APRES
  /// Frise verticale : date puis fait marquant.
  JALONS

  /// Bande d'accent : une citation, puis une ligne de références.
  /// Sans entrées — la citation est le titre de la section, les références
  /// sont sa note.
  CITATION
  /// Grille de cinq cartes numérotées : numéro en accent, titre, description.
  /// Sur fond sombre, le numéro passe en pastille pleine.
  ETAPES
  /// Grille de trois cartes : numéro d'ordre calculé, titre, description.
  PRINCIPES
  /// Grille de quatre cartes à filet supérieur coloré : titre, description.
  ENGAGEMENTS
  /// Bandeau de repères chiffrés : une valeur, un libellé.
  REPERES
  /// Organigramme : par pôle, sa responsabilité, sa mission, ses sous-rôles et
  /// le dossier qu'il porte.
  ///
  /// ⚠️ Ces pôles sont ceux de l'arrêté ministériel, et NON ceux du module
  /// « L'équipe », qui classe les fiches selon un découpage opérationnel plus
  /// fin. Deux nomenclatures distinctes, tenues séparément à dessein.
  POLES
  /// En-tête à deux colonnes, puis la grille des fiches publiées. Sans entrées.
  EQUIPE
  /// Accordéon de questions et de réponses.
  FAQ
  /// Bloc dépliant de sigles : sigle, puis ce qu'il recouvre.
  GLOSSAIRE
  /// Deux colonnes : texte et chiffres à gauche, aplat légendé à droite.
  CONTEXTE
  /// Cartes à trait d'accent : public visé, puis ce que le Projet lui apporte.
  PERSONAS
  /// En-tête à bouton, puis l'aperçu des cinq composantes. Sans entrées.
  COMPOSANTES
  /// En-tête à bouton, puis l'aperçu des indicateurs ODP. Sans entrées.
  INDICATEURS
}

/// Fond de la section, repris du design system (cf. `.section--*`).
enum ImpactTheme {
  CLAIR
  GRIS
  PALE
  SOMBRE
}

/// Un bloc « Histoires & impact » affiché sur une page publique.
model ImpactSection {
  id String @id @default(cuid())

  /// Identifiant stable, jamais affiché. Il sert d'ancrage à l'amorçage
  /// (cf. src/lib/impact/bootstrap.ts) : c'est lui qui garantit qu'une reprise
  /// du contenu d'origine ne crée pas de doublon si elle est rejouée.
  key String @unique

  emplacement ImpactEmplacement
  layout      ImpactLayout
  theme       ImpactTheme       @default(CLAIR)
  status      ImpactStatus      @default(DRAFT)

  /// Ordre entre les sections d'un MÊME emplacement. Deux sections peuvent
  /// légitimement se suivre au même endroit : une grille de chiffres puis une
  /// grille de témoignages, par exemple.
  position Int @default(0)

  /// Numéro affiché dans le kicker (« [ 03 ] Résultats »). Une chaîne et non un
  /// entier : la numérotation des sections du site est rédigée (« 02 »), pas
  /// calculée, et elle ne suit pas l'ordre de cette table.
  numero String?

  /// Section resserrée (`.section--sm`) : moins d'air vertical.
  compact    Boolean @default(false)
  /// La section POURSUIT la précédente : elle ne rouvre pas de bande, elle
  /// s'ajoute dans celle du dessus et son titre se rend en sous-titre.
  ///
  /// Deux blocs du site sont dans ce cas et l'ont toujours été : les
  /// engagements, sous les principes de la page « L'UGPTN », et le glossaire,
  /// sous la foire aux questions. En faire des sections à part entière
  /// doublerait l'espace vertical qui les sépare.
  ///
  /// Sans effet sur la première section d'un emplacement : rien ne la précède.
  enchaine   Boolean @default(false)
  /// Titre à la taille des grandes sections d'accueil (`.h2`) plutôt qu'à celle
  /// des sections secondaires (`.h2--sm`).
  grandTitre Boolean @default(false)

  /// Lien du bouton d'en-tête. Son libellé se traduit (cf. la traduction).
  ctaUrl String?

  /// Section dont celle-ci REPREND les entrées.
  ///
  /// Le site montre les mêmes quatre témoignages à deux endroits : un aperçu
  /// sur l'accueil, la grille complète en fin de page « Résultats ». Sans ce
  /// renvoi, il faudrait les saisir deux fois et les corriger deux fois — et la
  /// première correction oubliée ferait mentir l'une des deux pages.
  ///
  /// Une section qui reprend n'a pas d'entrées propres : elle porte son
  /// en-tête, son fond et sa place, et affiche les entrées de sa source.
  sourceId String?
  source   ImpactSection?  @relation("ImpactSource", fields: [sourceId], references: [id], onDelete: SetNull)
  reprises ImpactSection[] @relation("ImpactSource")

  /// Nombre maximal d'entrées affichées. Vide : toutes.
  limite Int?

  /// Trace de saisie, interne à la console.
  createdById String?
  createdBy   User?   @relation("ImpactSaisiPar", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations ImpactSectionTranslation[]
  items        ImpactItem[]

  @@index([emplacement, position])
  @@index([status])
}

/// En-tête d'une section dans une langue. Tout ce qui s'y lit est ici.
///
/// `titre` est FACULTATIF, contrairement au titre d'un article : la frise des
/// jalons de la page « Le projet » n'affiche qu'un kicker, et lui imposer un
/// H2 ajouterait au site un titre que son dessin n'a jamais porté. Une langue
/// est réputée servie dès qu'elle porte un kicker ou un titre.
model ImpactSectionTranslation {
  id        String        @id @default(cuid())
  sectionId String
  section   ImpactSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  /// Code de langue du site (« fr », « en » — cf. src/lib/params.ts).
  locale    String

  /// Libellé mono qui coiffe la section (« Impact humain »).
  kicker   String?
  titre    String?
  /// Chapô sous le titre.
  lead     String?
  /// Libellé du bouton d'en-tête. Sans `ctaUrl` sur la fiche, il ne s'affiche pas.
  ctaLabel String?
  /// Ligne courte que seuls certains gabarits affichent, et à un endroit qui
  /// leur est propre : les références sous une citation, la légende de l'aplat
  /// d'une section de contexte. Ailleurs, elle n'est pas demandée.
  note     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sectionId, locale])
  @@index([locale])
}

/// Une entrée d'une section : chiffre, témoignage, carte, diptyque ou jalon.
///
/// Les champs non linguistiques sont volontairement GÉNÉRIQUES, et leur emploi
/// dépend du gabarit de la section (cf. src/lib/impact/statut.ts, qui tient la
/// table de correspondance et les libellés que la console affiche).
model ImpactItem {
  id        String        @id @default(cuid())
  sectionId String
  section   ImpactSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  position Int          @default(0)
  status   ImpactStatus @default(PUBLISHED)
  /// Mise en avant. Le dessin en tire un liseré d'accent, jamais un changement
  /// de place : l'ordre reste celui de `position`, sinon la grille se réordonne
  /// sous les yeux de la rédaction sans qu'elle l'ait demandé.
  featured Boolean      @default(false)

  /// Valeur affichée en grand : « 30 M » pour un chiffre, « 01 » pour un
  /// diptyque. Une chaîne, parce que ce qui se lit n'est pas toujours un
  /// nombre et que « 30 M » n'est pas « 30000000 ».
  valeur  String?
  /// Couleur d'accent de l'entrée. Vide : l'accent du site.
  color   String?
  /// Identifiant YouTube du témoignage, le cas échéant.
  videoYt String?
  /// Lien sortant de l'entrée.
  lienUrl String?

  /// Étiquettes affichées en pastilles par le seul gabarit POLES : les
  /// sous-rôles rattachés au pôle.
  ///
  /// Hors traduction, et c'est le contenu d'origine qui le veut : « Responsable
  /// Passation des Marchés (RPM) » s'affichait déjà à l'identique dans les deux
  /// langues (cf. `Pole.roles` dans src/content/data.ts, seule liste du site
  /// qui n'était pas bilingue).
  tags String[] @default([])

  /// Date réelle d'un jalon. Elle sert à ORDONNER et à afficher la date dans la
  /// langue de lecture ; un libellé saisi dans la traduction la remplace quand
  /// la date exacte n'est pas connue (« T1 2026 »).
  dateAt DateTime?

  /// Visuel issu de la bibliothèque.
  coverMediaId String?
  coverMedia   MediaAsset? @relation(fields: [coverMediaId], references: [id], onDelete: SetNull)
  /// Repli : clé du registre d'images intégré (cf. src/content/media.ts).
  coverKey     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations ImpactItemTranslation[]

  @@index([sectionId, position])
}

/// Version d'une entrée dans une langue.
///
/// Quatre champs de texte couvrent les cinq gabarits, chacun désigné par son
/// RÔLE dans la carte plutôt que par le contenu d'un bloc particulier :
/// la console les réétiquette selon le gabarit (« Rôle & lieu » pour un
/// témoignage, « Unité » pour un chiffre, « Secteur » pour une carte).
model ImpactItemTranslation {
  id     String     @id @default(cuid())
  itemId String
  item   ImpactItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// Code de langue du site (« fr », « en » — cf. src/lib/params.ts).
  locale String

  /// Ligne courte au-dessus ou sous le titre : unité, rôle, secteur, date.
  surtitre        String?
  titre           String?
  /// Corps principal : explication, citation, situation visée, fait marquant.
  texte           String?
  /// Second corps, employé par le seul gabarit AVANT_APRES : la situation
  /// actuelle, celle que le Projet entend corriger.
  texteSecondaire String?
  /// Libellé du lien sortant. Sans `lienUrl` sur la fiche, il ne s'affiche pas.
  lienLabel       String?
  /// Texte alternatif du visuel, propre à la langue.
  mediaAlt        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itemId, locale])
  @@index([locale])
}

/// ===========================================================================
/// « L'équipe de l'Unité » — une fiche par poste, quatre affichages.
///
/// Le site montrait la même personne à quatre endroits, saisie dans trois
/// fichiers : la grille de l'accueil et celle de la page « L'Unité »
/// (`content/data.ts`), les cartes de coordination de la page « Gouvernance »
/// (`content/carbon.ts`) et le profil du responsable d'une composante
/// (`content/composantes-detail.ts`). Le coordonnateur y figurait trois fois,
/// sous trois intitulés différents : corriger son titre demandait trois
/// éditions, et la troisième était oubliée.
///
/// Une fiche vaut donc pour les quatre emplacements. Ce qui les distingue n'est
/// pas la personne mais ce qu'on montre d'elle : `featured` l'ajoute aux cartes
/// de coordination, `composante` l'installe sur la fiche de sa composante, et
/// la grille reçoit tout membre publié. Rien n'est saisi deux fois.
/// ===========================================================================

enum TeamStatus {
  DRAFT
  PUBLISHED
}

/// Pôle d'organisation de l'Unité (Direction, Fiduciaire, Passation…).
///
/// Une table plutôt qu'un enum : les pôles sont un choix d'organisation, pas
/// une donnée de structure. Un pôle scindé ou renommé relève de la console, non
/// d'une migration.
model TeamPole {
  id String @id @default(cuid())

  /// Identifiant stable, jamais affiché. Il ancre l'amorçage
  /// (cf. src/lib/equipe/bootstrap.ts) : c'est lui qui garantit qu'une reprise
  /// du contenu d'origine rejouée ne crée pas de doublon.
  key String @unique

  /// Ordre des pôles entre eux, quand la grille est groupée.
  position Int @default(0)

  /// Couleur d'accent du pôle, reprise par les cartes de coordination. Vide :
  /// l'accent du site.
  color String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations TeamPoleTranslation[]
  membres      TeamMember[]

  @@index([position])
}

/// Nom et mission d'un pôle dans une langue.
model TeamPoleTranslation {
  id     String   @id @default(cuid())
  poleId String
  pole   TeamPole @relation(fields: [poleId], references: [id], onDelete: Cascade)
  /// Code de langue du site (« fr », « en » — cf. src/lib/params.ts).
  locale String

  nom     String
  /// Ce dont le pôle répond, en une ligne (« Pilotage, arbitrage, contrôle
  /// interne »). Affiché sur la page « L'Unité ».
  mission String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([poleId, locale])
  @@index([locale])
}

/// Un membre de l'Unité — ou un poste, quand il n'est pas encore pourvu.
///
/// Une fiche sans nom est LÉGITIME et le site la dessine déjà ainsi : la grille
/// affiche l'intitulé du poste et une pastille d'initiales, la fiche de
/// composante annonce le recrutement en cours. C'est pourquoi `nom` est
/// facultatif alors que la fonction, portée par la traduction, ne l'est pas.
model TeamMember {
  id String @id @default(cuid())

  /// Identifiant stable, jamais affiché (cf. `TeamPole.key`).
  key String @unique

  /// Nom d'usage, hors traduction : « Noël Jean-David Litanga » s'écrit de même
  /// dans les deux langues. Une graphie propre à une langue reste possible sur
  /// la traduction, qui l'emporte alors.
  nom String?

  status   TeamStatus @default(DRAFT)
  /// Ordre d'affichage dans la grille. Il porte la hiérarchie voulue par
  /// l'Unité, que ni l'ordre alphabétique ni la date de saisie ne rendent.
  position Int        @default(0)

  /// Ajoute le membre aux cartes de coordination de la page « Gouvernance ».
  /// Ne change RIEN à sa place dans la grille : mettre en avant ne doit pas
  /// réordonner un écran sous les yeux de la rédaction.
  featured Boolean @default(false)

  /// Couleur d'accent de la carte de coordination. Vide : celle du pôle, puis
  /// l'accent du site.
  color String?

  /// Adresse de contact publiée sur la fiche de composante. Vide : l'adresse
  /// générale de l'Unité (cf. src/content/carbon.ts).
  email String?

  /// Composante dont ce membre est le responsable (« C1 »…« C5 »). Renseignée,
  /// la fiche publique de cette composante affiche ce profil. Une chaîne plutôt
  /// qu'une relation : les composantes sont une donnée de structure du projet,
  /// écrite dans le code et non administrée.
  composante String?

  poleId String?
  pole   TeamPole? @relation(fields: [poleId], references: [id], onDelete: SetNull)

  /// Portrait déposé depuis la console (Cloudinary).
  photoMediaId String?
  photoMedia   MediaAsset? @relation(fields: [photoMediaId], references: [id], onDelete: SetNull)
  /// Repli : chemin d'un portrait servi depuis `public/`, pour les fiches
  /// reprises de la version statique du site. Sans portrait ni l'un ni l'autre,
  /// la carte affiche les initiales — c'est un état prévu, pas une image
  /// manquante.
  photoPath    String?

  /// Trace de saisie, interne à la console.
  createdById String?
  createdBy   User?   @relation("TeamMemberSaisiPar", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations TeamMemberTranslation[]

  @@index([status, position])
  @@index([poleId])
  @@index([featured])
  @@index([composante])
}

/// Version d'une fiche dans une langue. Tout ce qui se lit est ici.
///
/// Les quatre champs de texte sont désignés par leur RÔLE dans la page, et non
/// par l'emplacement qui les affiche : la même responsabilité se lit sur une
/// carte de coordination et sur une fiche de composante. Un emplacement ajouté
/// plus tard puise dans les mêmes champs sans en demander de nouveaux.
model TeamMemberTranslation {
  id       String     @id @default(cuid())
  memberId String
  member   TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// Code de langue du site (« fr », « en » — cf. src/lib/params.ts).
  locale   String

  /// Graphie du nom propre à cette langue. Vide : le nom de la fiche.
  nom String?

  /// Fonction exercée (« Coordonnateur national »). Obligatoire : c'est le seul
  /// texte que toutes les cartes affichent, et une langue n'est réputée servie
  /// qu'à partir de lui.
  role String

  /// Ce dont le membre répond, en une phrase. Affiché par les cartes de
  /// coordination de la page « Gouvernance ».
  mandat String?

  /// Présentation développée, affichée sur la fiche de composante.
  bio String?

  /// Citation attribuée au membre, affichée entre guillemets sous sa bio.
  verbatim String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, locale])
  @@index([locale])
}

/// ===========================================================================
/// « Vidéos & galeries » — la bibliothèque de contenus visuels PUBLIABLES.
///
/// ─── Pourquoi une table à part, et non une vue sur `MediaAsset` ─────────────
///
/// Les deux modules manipulent des images déposées chez le même hébergeur, et
/// c'est leur seule ressemblance. `MediaAsset` est un MAGASIN de pièces : ses
/// entrées existent pour être RÉUTILISÉES ailleurs — couverture d'un article,
/// affiche d'un événement, portrait d'un membre — et n'ont aucune adresse
/// publique en propre. Une entrée de galerie, elle, est une PUBLICATION : elle
/// porte un titre, une description, une date de prise de vue, un statut de mise
/// en ligne et un rang d'affichage, et son existence même est de paraître sur
/// le site.
///
/// Les confondre coûterait des deux côtés. Verser tout `MediaAsset` dans la
/// galerie y ferait entrer les logos de partenaires et les visuels d'illustration,
/// que personne n'a choisi de montrer ; ajouter à `MediaAsset` les six colonnes
/// éditoriales de ce modèle imposerait à chaque téléversement d'article un
/// formulaire de publication dont il n'a que faire. Le modèle repris est donc
/// celui de `Document`, qui porte lui aussi ses propres références de fichier :
/// une pièce publiée détient son fichier, elle ne l'emprunte pas.
///
/// ─── Une seule table pour la photo ET la vidéo ──────────────────────────────
///
/// `type` distingue les deux, et rien d'autre ne les sépare : mêmes textes,
/// mêmes filtres, même grille, même visionneuse. Deux tables auraient obligé
/// chaque tri, chaque pagination et chaque compteur de la page publique à
/// fusionner deux listes ordonnées différemment — pour un affichage qui, lui,
/// mêle délibérément les deux.
///
/// ─── Le fichier n'est PAS ici ───────────────────────────────────────────────
///
/// Aucune colonne binaire, pour la raison déjà tenue sur `Document` et sur
/// `MediaAsset` : la base est sauvegardée, répliquée et facturée à l'octet, elle
/// n'a pas à servir de serveur de fichiers. Seules les références Cloudinary
/// sont enregistrées — l'adresse de diffusion et l'identifiant qui permet de
/// retirer le fichier du compte.
///
/// ─── Pourquoi pas de table de traduction ────────────────────────────────────
///
/// Les deux langues vivent en COLONNES (`titreFr` / `titreEn`), comme sur
/// `Document`. Une légende de photographie n'est pas un corps rédactionnel : ni
/// slug, ni SEO, ni cycle de relecture propre. Une table de traduction imposerait
/// un enregistrement séparé pour deux champs, alors que l'IMAGE, elle, est la
/// même dans les deux versions du site. L'anglais vide retombe sur le français :
/// mieux vaut une légende française à un lecteur anglophone qu'une photo muette.
/// ===========================================================================

/// Nature de l'entrée. Une enum et non une chaîne : c'est l'axe de filtre
/// principal de la page publique (« Photos » / « Vidéos »), et une saisie libre
/// y produirait autant de valeurs que de saisies.
enum GalerieType {
  PHOTO
  VIDEO
}

/// Visibilité de l'entrée sur le site.
///
/// Deux états, contrairement aux documents qui en ont trois. Le module répond à
/// une question binaire — ce contenu paraît-il, oui ou non — et `ARCHIVED` n'y
/// apporterait rien : une photographie retirée de la galerie n'est pas une
/// version remplacée qu'il faudrait pouvoir citer plus tard, c'est une image
/// qu'on ne montre plus. `DRAFT` la conserve en base, fichier compris, et suffit
/// donc à tout retrait non définitif.
enum GalerieStatus {
  DRAFT
  PUBLISHED
}

/// Un album : le reportage d'un événement, d'une mission, d'un chantier.
///
/// ─── Pourquoi un album n'est PAS une rubrique ───────────────────────────────
///
/// Les deux regroupent, et c'est là que s'arrête la ressemblance. Une RUBRIQUE
/// est une nomenclature : une poignée d'entrées stables, choisies d'avance, qui
/// servent de filtres et valent pour toute la durée du projet. Un ALBUM est un
/// ÉVÉNEMENT : « Atelier de Goma, mars 2026 » naît le jour du reportage, porte
/// sa propre date, son lieu, son texte de présentation, et n'a plus vocation à
/// bouger ensuite. Ranger les albums dans la table des rubriques ferait enfler
/// la barre de filtres d'une entrée par reportage, jusqu'à la rendre illisible.
///
/// Les deux axes se cumulent donc : l'album « Atelier de Goma » se range dans la
/// rubrique « Événements », comme un article se range dans une catégorie.
///
/// ─── L'album a sa propre page ───────────────────────────────────────────────
///
/// D'où le `slug` : contrairement à une entrée de galerie, qui n'est qu'une
/// vignette dans une mosaïque, un album est une PAGE — avec son titre, sa
/// description, ses métadonnées de partage et ses données structurées. C'est ce
/// qu'un reportage d'événement doit être pour être trouvé et partagé.
///
/// Un seul slug pour les deux langues, contrairement aux articles : le module
/// tient ses textes en colonnes bilingues et non en table de traduction
/// (cf. l'en-tête de `GalerieItem`), et un slug par langue supposerait cette
/// table. L'adresse est en anglais, comme tous les pathnames du site.
///
/// ─── Le rattachement est FACULTATIF ─────────────────────────────────────────
///
/// Une entrée peut vivre hors de tout album, et c'est le cas courant : la photo
/// isolée d'un chantier n'a pas de reportage autour d'elle. La galerie montre
/// donc les deux — les albums en tête, puis la mosaïque complète.
model GalerieAlbum {
  id     String        @id @default(cuid())
  /// Identifiant d'URL, stable : il apparaît dans /gallery/<slug>.
  slug   String        @unique
  status GalerieStatus @default(DRAFT)

  titreFr String
  /// Vide, le titre français est servi dans les deux langues (cf. l'en-tête).
  titreEn String?

  descriptionFr String?
  descriptionEn String?

  /// Lieu du reportage, tel qu'il s'affiche (« Goma », « Kinshasa »).
  lieu String?

  /// Date de l'ÉVÉNEMENT couvert — celle qui situe le reportage, et qui ordonne
  /// les albums entre eux. Distincte de la mise en ligne : un atelier de mars
  /// peut être publié en avril.
  dateAt      DateTime?
  /// Fin de la PÉRIODE couverte, quand le reportage s'étale sur plusieurs jours
  /// (« 12 – 14 mars 2026 »). Vide, l'album porte une date unique.
  ///
  /// Une seconde colonne plutôt qu'un libellé libre : la période doit rester
  /// TRIABLE et affichable dans les deux langues, ce qu'une chaîne saisie à la
  /// main ne permet pas — « du 12 au 14 mars » ne se traduit pas tout seul.
  dateFin     DateTime?
  /// Date de mise en ligne, posée à la première publication si elle est restée
  /// vide : un album en ligne sans date n'est classable par aucun tri.
  publishedAt DateTime?

  /// Mise en avant : remonte l'album en tête du bandeau de la galerie.
  featured Boolean  @default(false)
  /// Ordre d'affichage, à mise en avant égale. Plus petit = plus haut.
  position Int      @default(0)
  /// Composantes rattachées (C1…C5), même usage que sur un article.
  comps    String[] @default([])

  categoryId String?
  category   GalerieCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// Visuel de couverture, CHOISI PARMI LES CONTENUS de l'album.
  ///
  /// Une relation vers une entrée plutôt qu'un téléversement séparé : la
  /// couverture d'un reportage est l'une de ses photographies, et redemander le
  /// fichier ferait payer deux fois le même octet pour la même image. Vide, la
  /// couverture est la première entrée dans l'ordre d'affichage — un album n'est
  /// donc jamais sans vignette tant qu'il a un contenu.
  ///
  /// `SetNull` : retirer la photo de couverture ne doit pas emporter l'album.
  coverItemId String?
  coverItem   GalerieItem? @relation("AlbumCouverture", fields: [coverItemId], references: [id], onDelete: SetNull)

  /// Trace de saisie, interne à la console.
  createdById String?
  createdBy   User?   @relation("AlbumSaisiPar", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items GalerieItem[] @relation("AlbumContenu")

  @@index([status, position])
  @@index([categoryId])
  @@index([featured])
  @@index([dateAt])
}

/// Rubrique de la galerie (Activités, Événements, Projets, Actualités…).
///
/// Table et non enum, pour la raison déjà donnée sur `EvenementCategory` et
/// `DocumentCategory` : les rubriques d'un projet évoluent, et les renommer ou
/// les scinder relève de la console, pas d'une migration. Table DISTINCTE des
/// trois autres nomenclatures pour la même raison : les fusionner obligerait
/// chaque filtre à savoir de quel module vient chaque entrée.
model GalerieCategory {
  id        String   @id @default(cuid())
  /// Identifiant d'URL, stable : il apparaît dans ?rubrique=… .
  slug      String   @unique
  nomFr     String
  nomEn     String
  /// Couleur d'accent de la pastille. Vide = accent du site (var(--ac)).
  color     String?
  /// Ordre d'affichage des filtres.
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items  GalerieItem[]
  albums GalerieAlbum[]

  @@index([position])
}

/// Une photographie ou une vidéo publiée dans la galerie du site.
model GalerieItem {
  id     String        @id @default(cuid())
  type   GalerieType   @default(PHOTO)
  status GalerieStatus @default(DRAFT)

  titreFr String
  /// Vide, le titre français est servi dans les deux langues (cf. l'en-tête).
  titreEn String?

  descriptionFr String?
  descriptionEn String?

  /// Texte alternatif de l'image, propre à chaque langue.
  ///
  /// Distinct du titre, et c'est délibéré : le titre NOMME (« Pose de la fibre
  /// à Matadi »), l'alternatif DÉCRIT ce que montre l'image à qui ne la voit
  /// pas. Les confondre reviendrait à faire annoncer deux fois la même chose par
  /// un lecteur d'écran, une fois comme légende et une fois comme image. Vide,
  /// l'affichage retombe sur le titre — préférable à un attribut nul.
  altFr String?
  altEn String?

  /// Lieu de la prise de vue, tel qu'il s'affiche (« Kinshasa », « Nord-Kivu »).
  /// Hors traduction : un toponyme s'écrit de même dans les deux langues.
  lieu String?

  /// Date de la PRISE DE VUE ou du tournage — celle qui intéresse le visiteur.
  /// Distincte de la mise en ligne : une photo de 2024 peut paraître en 2026, et
  /// c'est la première qui situe la scène.
  priseAt     DateTime?
  /// Date de mise en ligne, posée à la première publication si elle est restée
  /// vide : une entrée en ligne sans date n'est classable par aucun tri.
  publishedAt DateTime?

  /// Mise en avant : remonte l'entrée en tête de la galerie et lui donne une
  /// cellule double dans la grille.
  featured Boolean  @default(false)
  /// Ordre d'affichage, à mise en avant égale. Plus petit = plus haut.
  position Int      @default(0)
  /// Composantes rattachées (C1…C5), même usage que sur un article.
  comps    String[] @default([])

  categoryId String?
  category   GalerieCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// Album auquel l'entrée appartient. FACULTATIF : une photographie isolée est
  /// un cas courant, pas un oubli.
  ///
  /// `SetNull` et non `Cascade` : supprimer un album libère ses contenus au lieu
  /// de les détruire. Effacer par mégarde le reportage d'un événement ne doit
  /// pas emporter quarante photographies dont on ne détient plus les originaux.
  /// La console annonce le nombre d'entrées libérées.
  albumId String?
  album   GalerieAlbum? @relation("AlbumContenu", fields: [albumId], references: [id], onDelete: SetNull)

  /// Albums dont cette entrée est la couverture. Un tableau parce que Prisma
  /// exige le côté inverse d'une relation ; en pratique il n'en porte qu'un.
  couvertureDe GalerieAlbum[] @relation("AlbumCouverture")

  /// --- Visuel : RÉFÉRENCES Cloudinary, jamais d'octets --------------------
  /// La photographie pour une entrée PHOTO, la vignette d'attente pour une
  /// entrée VIDEO. Une seule série de colonnes pour les deux usages : c'est la
  /// même image, au même format, dans la même grille — seul ce qu'on déclenche
  /// en cliquant diffère.
  imageUrl      String?
  /// Identifiant Cloudinary — seule prise pour retirer le fichier du compte à la
  /// suppression de l'entrée ou au remplacement du visuel.
  imagePublicId String?
  imageMime     String?
  /// Dimensions natives : elles donnent son ratio à la cellule de la grille, ce
  /// qui évite que la page se réorganise sous les yeux du visiteur au fil des
  /// chargements.
  imageWidth    Int?
  imageHeight   Int?
  /// Poids rapporté par Cloudinary, seule source du poids affiché en console.
  imageSize     Int     @default(0)

  /// --- Vidéo -------------------------------------------------------------
  /// Une SEULE provenance : un fichier téléversé depuis la console, déposé chez
  /// Cloudinary comme n'importe quel autre média.
  ///
  /// Les deux autres voies un temps prévues — un identifiant YouTube, une
  /// adresse de fichier saisie à la main — ont été RETIRÉES : elles demandaient
  /// une saisie par vidéo, ce que le module refuse par principe (l'information
  /// vit sur l'album), et n'ont jamais servi. Aucune donnée ne les employait.
  ///
  /// Adresse de diffusion du fichier, telle que Cloudinary la renvoie.
  videoUrl      String?
  /// Identifiant Cloudinary du fichier vidéo — la seule prise pour le retirer du
  /// compte à la suppression de l'entrée.
  videoPublicId String?
  /// Durée en secondes, telle que Cloudinary la rapporte au dépôt. Jamais
  /// saisie : une durée tapée à la main se désaccorde du fichier au premier
  /// remplacement.
  videoDuree    Int?

  /// Trace de saisie, interne à la console.
  createdById String?
  createdBy   User?   @relation("GalerieSaisiPar", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, position])
  @@index([type])
  @@index([categoryId])
  @@index([albumId, position])
  @@index([featured])
  @@index([priseAt])
}

/// ===========================================================================
/// « Le projet » — les composantes et le cadre de résultats.
///
/// Le groupe « Le projet » de la navigation publique tient trois pages : la
/// page du Projet, l'index des composantes et leurs cinq pages dédiées, et la
/// page des résultats. Seules les BANDES DE RÉCIT de la première étaient
/// administrables (cf. `ImpactSection`) ; tout le reste — les cinq composantes,
/// leurs sous-composantes, leur problématique, leurs projets phares, et les
/// indicateurs du cadre de résultats — vivait en dur dans `src/content/`.
///
/// Deux ensembles, donc, et une même règle que partout ailleurs : ce qui
/// appartient à la FICHE d'un côté, ce qui appartient à UNE LANGUE de l'autre.
///
/// ⚠️ Ces données restent CANONIQUES au sens du Manuel d'Exécution : montants,
/// clés IDA/AFD, références de sous-composantes et valeurs cibles des
/// indicateurs ne sont pas de la rédaction. Les rendre administrables ne les
/// rend pas discutables — cela évite qu'une correction du MEP demande une mise
/// en production.
/// ===========================================================================

enum ProjetStatus {
  DRAFT
  PUBLISHED
}

/// Nature d'un bloc d'une composante.
///
/// Une SEULE table porte les huit listes d'une page de composante, distinguées
/// par ce type. Huit tables spécialisées demanderaient huit formulaires pour un
/// geste identique — ajouter une ligne, la déplacer, la traduire — alors que
/// leurs champs se recouvrent presque entièrement (cf. src/lib/projet/statut.ts,
/// qui tient la table des champs demandés et de leurs intitulés).
enum ComposanteBlocType {
  /// Sous-composante du MEP : sa référence (« 1.2 »), son intitulé, sa dotation.
  SOUS_COMPOSANTE
  /// Un paragraphe du contexte, dans la colonne de gauche de la page.
  CHAPEAU
  /// Un axe de la problématique : constat, mécanisme, coût de l'inaction.
  PB_AXE
  /// Un paragraphe de l'appui : ce qui légitime l'intervention publique.
  PB_APPUI
  /// Un renvoi de la problématique. `cible` pointe vers une autre composante,
  /// ou reste vide pour un renvoi hors projet (énergie, cadre juridique).
  PB_LIEN
  /// Un objectif de la composante.
  OBJECTIF
  /// Un projet phare : corps rédigé, puces, chute.
  PROJET
  /// Une brique de l'écosystème (section sombre).
  ECO_COUCHE
  /// Un point de la finalité.
  FIN_POINT
}

/// Une composante du Projet, telle que le site la publie.
model Composante {
  id String @id @default(cuid())

  /// Identifiant stable, jamais affiché. Ancrage de l'amorçage
  /// (cf. src/lib/projet/bootstrap.ts) : c'est lui qui garantit qu'une reprise
  /// du contenu d'origine ne crée pas de doublon si elle est rejouée.
  key String @unique

  /// Code du MEP (« C1 »). Il s'affiche partout et sert de clé de rattachement
  /// aux fiches de l'équipe, aux marchés et aux renvois entre composantes.
  code   String @unique
  /// Segment d'URL de la page dédiée (« c1 »).
  slug   String @unique
  /// Accent de la composante, en hexadécimal. Il teinte la page entière
  /// (cf. `compTint` dans src/lib/comp.ts).
  color  String
  status ProjetStatus @default(DRAFT)
  /// Ordre de lecture, de C1 à C5.
  position Int @default(0)

  /// --- Données canoniques du MEP ------------------------------------------
  /// Dotation en millions de dollars. `0` pour une composante non dotée (CERC).
  montant Float @default(0)
  ida     Float @default(0)
  afd     Float @default(0)

  /// Indicateurs d'objectif rattachés, par leur code (« ODP-1 »). La page de la
  /// composante en tire sa grille ; un code inconnu est simplement ignoré.
  odpCodes String[] @default([])

  /// --- Visuel du héros -----------------------------------------------------
  coverMediaId String?
  coverMedia   MediaAsset? @relation("ComposanteCouverture", fields: [coverMediaId], references: [id], onDelete: SetNull)
  /// Repli : clé du registre d'images intégré (cf. src/content/media.ts).
  coverKey     String?

  /// --- Vidéo de présentation ----------------------------------------------
  /// L'emplacement existe dès qu'un poster est choisi : sans fichier ni
  /// identifiant, la page affiche l'état « à venir » plutôt qu'une zone vide.
  videoYt        String?
  /// Fichier servi directement (« /videos/… »), quand la vidéo n'est pas sur
  /// YouTube.
  videoSrc       String?
  /// Durée affichée sous le libellé, telle qu'elle doit se lire (« 4 min »).
  videoDuree     String?
  videoPosterKey String?

  /// Trace de saisie, interne à la console.
  createdById String?
  createdBy   User?   @relation("ComposanteSaisiePar", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations ComposanteTranslation[]
  blocs        ComposanteBloc[]

  @@index([status, position])
}

/// Version d'une composante dans une langue.
///
/// Deux registres cohabitent, et c'est voulu : le couple `titre` / `desc` est
/// la formulation COURTE du MEP, celle des cartes et des lignes d'aperçu ; le
/// couple `titreLong` / `soustitre` est la formulation ÉDITORIALE, celle du
/// héros de la page dédiée. Les fondre donnerait un titre de carte long de
/// deux lignes, ou un H1 qui ne dit rien de plus que l'étiquette.
model ComposanteTranslation {
  id           String     @id @default(cuid())
  composanteId String
  composante   Composante @relation(fields: [composanteId], references: [id], onDelete: Cascade)
  /// Code de langue du site (« fr », « en » — cf. src/lib/params.ts).
  locale       String

  /// Intitulé court du MEP (« Accès & inclusion numériques »).
  titre     String?
  /// Description courte, affichée sur les cartes et les lignes d'aperçu.
  desc      String?
  /// H1 éditorial de la page dédiée.
  titreLong String?
  /// Chapô du héros de la page dédiée.
  soustitre String?

  /// En-tête de « La problématique ».
  pbTitre String?
  pbLead  String?

  /// En-tête de « L'écosystème » (section sombre).
  ecoTitre String?
  ecoLead  String?

  /// En-tête de « La finalité ».
  finTitre String?
  finLead  String?

  /// Titre de la vidéo de présentation, qui sert aussi d'alternative au poster.
  videoTitre String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([composanteId, locale])
  @@index([locale])
}

/// Une ligne d'une des huit listes d'une composante (cf. `ComposanteBlocType`).
model ComposanteBloc {
  id           String     @id @default(cuid())
  composanteId String
  composante   Composante @relation(fields: [composanteId], references: [id], onDelete: Cascade)

  type     ComposanteBlocType
  position Int                @default(0)
  status   ProjetStatus       @default(PUBLISHED)

  /// Référence affichée en mono : « 1.2 » pour une sous-composante, « 01 » pour
  /// un projet phare. Une chaîne, parce qu'elle est rédigée et non calculée.
  reference String?
  /// Sigle d'un projet phare (« GOVNET »), affiché devant son titre.
  sigle     String?
  /// Ancre d'un projet phare dans la page (« cloud-souverain »).
  slug      String?
  /// Dotation d'une sous-composante, en millions de dollars.
  montant   Float?
  /// Code de la composante visée par un renvoi (`PB_LIEN`). Vide : renvoi hors
  /// projet, qui s'affiche alors sans lien.
  cible     String?

  /// Visuel d'un projet phare.
  coverMediaId String?
  coverMedia   MediaAsset? @relation("ComposanteBlocVisuel", fields: [coverMediaId], references: [id], onDelete: SetNull)
  coverKey     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations ComposanteBlocTranslation[]

  @@index([composanteId, type, position])
}

/// Version d'un bloc dans une langue.
///
/// Deux champs de LIGNES s'ajoutent aux trois champs de texte : un projet phare
/// se compose de plusieurs paragraphes et d'une liste de puces, que rien
/// n'obligerait à saisir dans un ordre figé. Les stocker en tableau évite un
/// niveau de table de plus pour une liste qui ne porte ni ordre propre ni
/// réglage.
model ComposanteBlocTranslation {
  id     String         @id @default(cuid())
  blocId String
  bloc   ComposanteBloc @relation(fields: [blocId], references: [id], onDelete: Cascade)
  /// Code de langue du site (« fr », « en » — cf. src/lib/params.ts).
  locale String

  /// Intitulé de la ligne : l'axe, l'objectif, le projet, la couche, le point.
  titre           String?
  /// Corps principal : la description d'un axe, la chute d'un projet phare, le
  /// paragraphe d'un contexte ou d'un appui.
  texte           String?
  /// Ligne courte propre à un gabarit : le statut affiché d'un projet phare.
  texteSecondaire String?

  /// Paragraphes du corps d'un projet phare, un par entrée.
  paragraphes String[] @default([])
  /// Puces d'un projet phare, une par entrée.
  puces       String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([blocId, locale])
  @@index([locale])
}

/// Famille d'un indicateur du cadre de résultats.
enum IndicateurFamille {
  /// Indicateur de l'Objectif de Développement du Projet. Quatre, affichés en
  /// grille sur l'accueil, « Le projet », « Résultats » et les composantes.
  ODP
  /// Indicateur de résultat intermédiaire. Seule la page « Résultats » les
  /// porte.
  INTERMEDIAIRE
}

/// Un indicateur du cadre de résultats.
model Indicateur {
  id String @id @default(cuid())

  /// Identifiant stable, jamais affiché — ancrage de l'amorçage.
  key String @unique

  famille  IndicateurFamille
  /// Code affiché en mono (« ODP-1 »). Vide pour un indicateur intermédiaire,
  /// dont le dessin n'en montre pas.
  code     String?
  status   ProjetStatus      @default(DRAFT)
  position Int               @default(0)

  /// Valeur telle qu'elle doit s'afficher, séparateurs compris : « 10 000 ».
  /// Une chaîne, parce que ce qui se lit n'est pas toujours un nombre.
  valeur    String
  /// La même valeur en nombre, quand le dessin l'anime au défilement (les ODP).
  /// Vide : la valeur s'affiche telle quelle, sans compteur.
  valeurNum Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations IndicateurTranslation[]

  @@index([famille, position])
  @@index([status])
}

/// Version d'un indicateur dans une langue.
model IndicateurTranslation {
  id           String     @id @default(cuid())
  indicateurId String
  indicateur   Indicateur @relation(fields: [indicateurId], references: [id], onDelete: Cascade)
  /// Code de langue du site (« fr », « en » — cf. src/lib/params.ts).
  locale       String

  /// Ce que l'indicateur mesure.
  label    String?
  /// Point de départ, tel qu'il doit se lire (« 6,56 kbit/s »). La virgule
  /// décimale du français devient un point en anglais : le champ se traduit.
  baseline String?
  /// Précision affichée en pastille d'accent (« dont environ la moitié de
  /// femmes »). Vide : aucune pastille.
  note     String?

  /// Unité affichée à droite de la valeur (« millions », « jours », « km »).
  ///
  /// Même raison que `ArticleTranslation.authorRole` : « millions » et
  /// « jours » se traduisent, et une colonne unique sur la fiche les laissait
  /// en français sur la grille anglaise. Les unités symboliques (« km »,
  /// « kbit/s ») se recopient simplement à l'identique.
  unit     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([indicateurId, locale])
  @@index([locale])
}

/// ===========================================================================
/// « L'UGPTN » — la gouvernance du Projet.
///
/// Le menu « L'UGPTN » du site tient deux pages. La première, « L'Unité »,
/// était déjà administrable bloc par bloc (cf. `ImpactSection`, emplacements
/// `UGPTN_*`). La seconde, « Gouvernance », ne l'était pas du tout : les trois
/// organes vivaient dans `src/content/data.ts`, la chronique de leurs décisions
/// dans `src/content/carbon.ts`, et — plus gênant — la COMPOSITION du comité de
/// pilotage et du comité technique était écrite dans le DICTIONNAIRE DE
/// TRADUCTION, à côté des libellés d'interface. Corriger un siège demandait
/// d'éditer `i18n.ts` ; ajouter un organe demandait de réécrire la page, dont
/// la section « Composition » nommait COPIL et CTP en toutes lettres.
///
/// ⚠️ Ces données sont CANONIQUES au sens de l'arrêté : sigles, présidence,
/// règles de décision et fréquences ne sont pas de la rédaction. Les rendre
/// administrables ne les rend pas discutables — cela évite qu'un remaniement
/// demande une mise en production.
/// ===========================================================================

enum GouvernanceStatus {
  DRAFT
  PUBLISHED
}

/// Un organe de gouvernance : comité de pilotage, comité technique, Unité.
model Organe {
  id String @id @default(cuid())

  /// Identifiant stable, jamais affiché — ancrage de l'amorçage
  /// (cf. src/lib/gouvernance/bootstrap.ts).
  key String @unique

  /// Sigle affiché en grand sur la carte (« COPIL »). Il sert aussi à
  /// rattacher une décision à l'organe qui l'a prise.
  sigle    String            @unique
  status   GouvernanceStatus @default(DRAFT)
  /// Ordre de lecture : du plus stratégique au plus opérationnel.
  position Int               @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations OrganeTranslation[]

  @@index([status, position])
}

/// Version d'un organe dans une langue.
///
/// La COMPOSITION vit ici et non dans une table de sièges : un siège est un
/// intitulé d'institution (« MPTN — Président », « MIS ×2 »), sans attribut ni
/// ordre propre. Une table de plus demanderait un écran de plus pour saisir ce
/// qu'une liste de lignes dit déjà — même raisonnement que les puces d'un
/// projet phare (cf. `ComposanteBlocTranslation`).
model OrganeTranslation {
  id       String @id @default(cuid())
  organeId String
  organe   Organe @relation(fields: [organeId], references: [id], onDelete: Cascade)
  /// Code de langue du site (« fr », « en » — cf. src/lib/params.ts).
  locale   String

  /// Nom développé (« Comité de Pilotage »).
  nom       String?
  /// Ce qu'il est (« Stratégique / décisionnel »).
  nature    String?
  /// Effectif tel qu'il doit se lire (« 8 membres »). Bilingue : « 8 membres »
  /// restait en français sur la version anglaise avant la reprise.
  effectif  String?
  presidence String?
  decision  String?
  frequence String?

  /// Ce que l'organe fait, en un paragraphe. Sans lui, l'organe ne paraît pas
  /// dans la section « Composition » — seulement dans la grille des cartes.
  composition String?
  /// Un siège par entrée, dans l'ordre où ils s'affichent.
  membres     String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organeId, locale])
  @@index([locale])
}

/// Une décision ou une mission datée, portée à la chronique de la gouvernance.
model GouvActivite {
  id String @id @default(cuid())

  /// Identifiant stable, jamais affiché — ancrage de l'amorçage.
  key String @unique

  status   GouvernanceStatus @default(DRAFT)
  /// Ordre d'affichage, du plus récent au plus ancien. Saisi et non déduit de
  /// `dateAt` : la chronique mêle des dates exactes et des mois, et un tri
  /// automatique ferait remonter « Juin 2026 » au-dessus d'un jour de juin.
  position Int               @default(0)

  /// Instance à l'origine du fait, telle qu'elle s'affiche en pastille. Une
  /// chaîne libre et non le sigle d'un `Organe` : la chronique porte aussi des
  /// faits de « Coordination », qui n'est pas un organe de gouvernance.
  org   String
  /// Couleur de la pastille et du filet gauche.
  color String

  /// Date réelle, quand elle est connue. Elle ne sert qu'à ranger la saisie en
  /// console ; ce qui s'affiche est le libellé traduit.
  dateAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations GouvActiviteTranslation[]

  @@index([status, position])
}

/// Version d'une décision dans une langue.
model GouvActiviteTranslation {
  id         String       @id @default(cuid())
  activiteId String
  activite   GouvActivite @relation(fields: [activiteId], references: [id], onDelete: Cascade)
  /// Code de langue du site (« fr », « en » — cf. src/lib/params.ts).
  locale     String

  /// Date affichée, rédigée (« Juin 2026 », « Jun 2026 »).
  dateLabel String?
  titre     String?
  /// Ce que la décision emporte, en une phrase.
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([activiteId, locale])
  @@index([locale])
}

/// ===========================================================================
/// Traduction assistée
///
/// Le site s'écrit dans une langue puis se traduit. Le module d'assistance
/// prend la relève dès l'enregistrement : il compose la version manquante et
/// la dépose dans la table de traduction de l'entité, comme l'aurait fait un
/// traducteur. Ce qu'il produit est du contenu ORDINAIRE — les pages publiques
/// n'ont rien à savoir de son origine.
///
/// Ce qui vit ici n'est donc pas le texte, mais la TÂCHE : ce qui a été
/// demandé, ce qui a abouti, ce qui a échoué, et ce qu'un humain a relu.
/// Trois raisons de la loger dans une table à part plutôt qu'en colonnes sur
/// chacune des onze tables de traduction :
///
///   1. c'est un état de traitement, avec ses échecs et ses reprises, pas un
///      attribut du contenu ;
///   2. onze copies du même cycle de vie divergeraient à la première évolution ;
///   3. un site institutionnel doit pouvoir établir ce qui a été rédigé par une
///      machine, et sur quel modèle — c'est le journal qui l'établit.
///
/// L'entité est désignée par un COUPLE (`entite`, `entiteId`) et non par une
/// clé étrangère : onze relations facultatives vers onze tables donneraient
/// onze colonnes nulles sur chaque ligne. La contrepartie est qu'aucune
/// cascade ne joue à la suppression — c'est `oublierTraductions()`
/// (src/lib/ia/suivi.ts) qui s'en charge, appelé par les actions de
/// suppression.
/// ===========================================================================

/// Où en est la version d'une entité dans une langue.
///
/// `RELUE` ne signifie pas « corrigée » : il signifie qu'une personne a ouvert
/// cette langue et l'a enregistrée. C'est le geste que la console peut
/// constater, et le seul qui vaille engagement.
enum TraductionStatut {
  /// Demandée, pas encore traitée. Une reprise peut la reprendre.
  EN_ATTENTE
  /// Confiée au modèle. Au-delà du délai de garde, réputée interrompue.
  EN_COURS
  /// Écrite en base, jamais relue.
  GENEREE
  /// Enregistrée par une personne depuis la console.
  RELUE
  /// Le modèle n'a rien rendu d'exploitable. `erreur` dit quoi.
  ECHEC
}

/// Une tâche de traduction : une entité, une langue produite.
///
/// Une seule ligne par couple (entité, langue) : une nouvelle demande sur une
/// langue déjà traitée réécrit celle-ci plutôt que d'empiler un historique que
/// personne ne lirait. Le journal utile est celui des ÉTATS courants — ce qui
/// reste à relire, ce qui a échoué.
model TraductionAssistee {
  id String @id @default(cuid())

  /// Clé de l'entité dans le registre (cf. src/lib/ia/registre.ts) :
  /// « article », « evenement », « organe »…
  entite   String
  /// Identifiant de l'entité PORTEUSE (l'article, l'organe), jamais celui de
  /// la ligne de traduction.
  entiteId String

  /// Langue PRODUITE.
  locale       String
  /// Langue lue pour la produire.
  sourceLocale String

  statut TraductionStatut @default(EN_ATTENTE)

  /// Modèle qui a rendu le texte, tel que le fournisseur le nomme. Conservé
  /// même après relecture : c'est la trace qui permet d'établir l'origine.
  modele String?
  /// Champs effectivement écrits, pour dire à la console ce qui a bougé.
  champs String[] @default([])

  /// Intitulé du contenu au moment du traitement, RECOPIÉ et non lu à la
  /// demande. L'écran de suivi liste des contenus de onze types différents :
  /// les nommer autrement supposerait onze lectures par affichage, pour un
  /// libellé qui ne sert qu'à s'y retrouver.
  intitule String?

  /// Motif d'échec, rendu tel quel à la console. Vidé à la reprise.
  erreur String?

  demandeeLe DateTime  @default(now())
  produiteLe DateTime?
  relueLe    DateTime?

  /// Qui a relu. `SetNull` : la suppression d'un compte ne doit pas effacer le
  /// fait qu'une relecture a eu lieu.
  relueParId String?
  reluePar   User?   @relation("TraductionReluePar", fields: [relueParId], references: [id], onDelete: SetNull)

  @@unique([entite, entiteId, locale])
  @@index([statut])
  @@index([entite, statut])
}
