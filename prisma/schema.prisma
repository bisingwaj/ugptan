// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model TestConnection {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  message   String
}

/// Rôles de la console. Le rôle porte le socle de droits ; `User.permissions`
/// ajoute des modules au cas par cas (cf. src/lib/auth/permissions.ts).
/// ADMIN est le seul rôle habilité à gérer les comptes.
enum Role {
  ADMIN
  EDITOR
  VIEWER
}

/// Compte de la console d'administration.
///
/// Aucune inscription publique : les comptes sont créés exclusivement depuis le
/// module « Utilisateurs » par un ADMIN, et le premier compte par le seed
/// (prisma/seed.ts). `passwordHash` est un scrypt au format `selHex:hashHex`,
/// jamais un mot de passe en clair (cf. src/lib/auth/password.ts).
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         Role      @default(EDITOR)
  /// Modules autorisés en plus du socle du rôle. Vide pour un ADMIN, qui a tout.
  permissions  String[]  @default([])
  /// Désactivation : conserve le compte et son historique, coupe l'accès.
  /// Contrôlé à chaque requête par `requireAdmin()`, donc les sessions déjà
  /// ouvertes tombent au prochain chargement de page.
  isActive     Boolean   @default(true)
  /// Repère de révocation : tout jeton émis avant cette date est refusé.
  /// Changer un mot de passe ferme donc les sessions ouvertes ailleurs.
  passwordChangedAt DateTime @default(now())
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([role])
}
