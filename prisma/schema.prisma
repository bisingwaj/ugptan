}

/// Catégorie d'événement (Forum, Atelier, Webinaire, Consultation publique…).
///
/// Jumelle d'`ArticleCategory` sans être la même table : les deux nomenclatures
/// n'ont pas le même contenu ni la même durée de vie, et les fusionner
/// obligerait chaque filtre à savoir de quel module vient chaque entrée.
model EvenementCategory {
  id    String @id @default(cuid())
  /// Identifiant d'URL, stable : il apparaît dans ?categorie=… .
  slug  String @unique
  nomFr String
  nomEn String
  /// Couleur d'accent de la pastille. Vide = accent du site (var(--ac)).
  color String?
  /// Ordre d'affichage des filtres.
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evenements Evenement[]

  @@index([position])
}

