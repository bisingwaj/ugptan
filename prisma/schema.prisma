/// brute : « Goma — provinces de l'Est » et « Goma — Eastern provinces » sont
/// deux libellés, pas une donnée géographique. L'adresse postale, elle, reste
/// traduisible aussi (le nom d'un bâtiment se traduit), mais n'est jamais
/// obligatoire.
model EvenementTranslation {
  id          String    @id @default(cuid())
  evenementId String
  evenement   Evenement @relation(fields: [evenementId], references: [id], onDelete: Cascade)
  /// Code de langue du site (« fr », « en » — cf. src/lib/params.ts).
  locale      String

  title String
  /// Segment d'URL, unique DANS SA LANGUE : /fr/evenements/<slug>.
  slug  String

  /// Description courte affichée sur les cartes et dans les partages.
  excerpt     String?
  /// Description complète, HTML déjà assaini à l'écriture
  /// (cf. src/lib/html/sanitize.ts). Jamais de HTML brut de l'éditeur en base.
  contentHtml String  @default("")

  /// Libellé du lieu tel qu'il s'affiche (« Kinshasa », « En ligne »).
  lieu    String?
  /// Adresse ou repère de localisation, quand la salle doit être trouvée.
  adresse String?
  /// Jauge affichée (« 320 places », « Ouvert à tous »). Un libellé et non un
  /// nombre : le site annonce aussi bien une capacité qu'une règle d'accès.
  places  String?
  /// Informations complémentaires : accès, interprétation, pièces à apporter.
  infos   String?

  seoTitle       String?
  seoDescription String?
  /// Texte alternatif de l'image de couverture, propre à la langue.
  coverAlt       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([evenementId, locale])
  @@unique([locale, slug])
  @@index([locale])
}

/// État d'une demande de participation.
///
/// `RECUE` est le seul état qu'une personne peut provoquer elle-même : tous les
/// autres sont posés par l'Unité depuis la console. La distinction compte pour
/// le décompte des places — une demande reçue n'occupe pas encore de siège.
enum InscriptionStatus {
  RECUE
  CONFIRMEE
  LISTE_ATTENTE
  ANNULEE
}

/// Demande de participation déposée par le formulaire public d'un événement.
///
/// ⚠️ Ces lignes portent des DONNÉES PERSONNELLES (identité, adresse, éventuelle
/// organisation) collectées sans compte. Trois conséquences tenues partout :
///   1. elles ne sortent JAMAIS vers le site public — aucune fonction de
///      `lib/events/query.ts` ne les lit, seule la console y accède ;
///   2. elles tombent avec l'événement (`onDelete: Cascade`) : supprimer une
///      rencontre ne doit pas laisser derrière elle une liste de participants ;
///   3. l'adresse fait l'unicité, pour qu'un double envoi mette à jour la
///      demande au lieu d'inscrire deux fois la même personne.
///
/// Le formulaire n'est proposé que si l'événement n'a PAS de lien d'inscription
/// externe : quand la billetterie est ailleurs, c'est elle qui tient la liste,
/// et en tenir une seconde ici la rendrait fausse.
model EvenementInscription {
  id          String    @id @default(cuid())
  evenementId String
  evenement   Evenement @relation(fields: [evenementId], references: [id], onDelete: Cascade)

  nom          String
  email        String
  organisation String?
  telephone    String?
  /// Question ou besoin d'accessibilité signalé au dépôt.
  message      String?

  /// Langue du formulaire au moment du dépôt — sert à répondre dans la langue
  /// où la personne s'est adressée à l'Unité.
  locale String @default("fr")

  statut InscriptionStatus @default(RECUE)
  /// Note interne de la console, jamais communiquée au demandeur.
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([evenementId, email])
  @@index([evenementId, statut])
  @@index([createdAt])
