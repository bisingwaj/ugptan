# Origine publique canonique du site (sans slash final).
# Utilisée pour toutes les URL absolues : metadataBase, sitemap.xml, robots.txt,
# balises Open Graph / canonical.
#
# À définir dans les variables d'environnement du projet (Vercel : Project
# Settings → Environment Variables ; Netlify : Site settings → Environment).
# En son absence, la valeur de production par défaut https://www.ugptn.cd est utilisée.
NEXT_PUBLIC_SITE_URL=https://www.ugptn.cd
DATABASE_URL=""

# --- Console d'administration (cf. src/lib/admin.ts) -------------------------
# Sans ces deux variables, la connexion à la console est impossible.
#
# 1) Mot de passe administrateur, au format scrypt "selHex:hashHex".
#    Génération (saisie masquée, rien dans l'historique du shell) :
#      read -rs -p "Mot de passe admin: " PW; echo
#      PW="$PW" node -e 'const c=require("node:crypto");const s=c.randomBytes(16);const h=c.scryptSync(process.env.PW,s,64,{N:16384,r:8,p:1});console.log(s.toString("hex")+":"+h.toString("hex"))'; unset PW
ADMIN_PASSWORD_HASH=""
#
# 2) Clé de signature du cookie de session (HMAC-SHA256).
#    Génération :
#      node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64url"))'
#    La changer invalide immédiatement toutes les sessions en cours.
SESSION_SECRET=""